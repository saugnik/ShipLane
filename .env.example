# ---- Database (required) -----------------------------------------------
# Postgres. Grab a free one at https://neon.com.
#
# TWO urls are needed, and they differ only by "-pooler" in the hostname:
#
#   DATABASE_URL  pooled   — used by the running app. Serverless opens many
#                            short-lived connections, so pooling is essential.
#   DIRECT_URL    direct   — used by `prisma migrate` only. The pooler runs
#                            PgBouncer in transaction mode and cannot hold the
#                            session-level advisory lock Migrate needs, so
#                            migrating through it fails with P1002.
#
# Both are SERVER-ONLY secrets. Never rename either to NEXT_PUBLIC_* — Next.js
# inlines those into the browser bundle, publishing your credentials.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---- Public origin (set once you attach a domain) ----------------------
# Used for canonical URLs, link previews and the sitemap. Include the scheme
# and no trailing slash. On Vercel this falls back to the deployment URL, so it
# is only strictly needed once a custom domain is live.
NEXT_PUBLIC_SITE_URL="https://shippbie.com"

# ---- Authentication (required) -----------------------------------------
# Signs the session cookie. Any random string of 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# The single oversight account. There is no admin registration — it exists only
# because it is seeded from here by `npm run db:seed`. Re-seeding rotates the
# password and signs out any existing admin session.
# Sign in at /admin/login, which is linked from nowhere in the UI.
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD=""

# Owner of the seeded demo consignments — sign in with these at /login.
DEMO_EMAIL="demo@shiplane.example"
DEMO_PASSWORD="shiplane-demo-2026"

# ---- Email / OTP -------------------------------------------------------
# Registration emails a 6-digit code to prove the address is actually read by
# the person signing up. Sign-in stays email + password.
#
# Two transports. Google is preferred and is what the deployment uses: the
# domain already runs on Google Workspace, so its SPF and DKIM authorise Google
# to send for it — mail passes DMARC with no extra DNS, no provider signup, and
# none of the new-account abuse review that suspends transactional senders.
#
#   GMAIL_USER           the Workspace mailbox to send as
#   GMAIL_APP_PASSWORD   a 16-character app password, NOT the account password.
#                        Google account -> Security -> 2-Step Verification (must
#                        be on) -> App passwords. Spaces are stripped, so pasting
#                        it in Google's four-character groups is fine.
#
# Mailjet is kept as a fallback so switching back is an env var, not a code
# change. MAIL_FROM applies to Mailjet only and must be a validated sender
# there; over Google the From is always GMAIL_USER, because Gmail rewrites it to
# the authenticated mailbox anyway.
#
# MAIL_PROVIDER forces one transport ("google" or "mailjet"). Left blank, the
# app picks Google when it is configured and Mailjet otherwise.
#
# With nothing configured the app runs in demo mode: the code is logged AND
# shown in the browser behind a warning banner. Fine for a demo, unacceptable in
# production — anyone loading the page could then register any address. Set
# OTP_ECHO=off to disable the echo without configuring mail.
#
# NOTE: this file is COMMITTED to git. Never put a real key here — put it in
# .env, which is gitignored.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

MAILJET_API_KEY=""
MAILJET_SECRET_KEY=""
MAIL_FROM="no-reply@example.com"
MAIL_FROM_NAME="Shippbie"

MAIL_PROVIDER=""
OTP_ECHO=""

# ---- Google Maps (optional) --------------------------------------------
# Without a key the booking form falls back to manual address entry backed by
# the built-in PIN code lookup. With one, you get Places autocomplete plus a
# drag-to-correct map pin.
#
# Enable on the key: "Maps JavaScript API", "Places API (New)", "Geocoding API".
# Restrict it by HTTP referrer — it is exposed to the browser by design.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# ---- Branding (optional) -----------------------------------------------
# Everything customer-visible reads from src/lib/brand.ts, which falls back to
# these. Set them to white-label the console and the printed documents.
NEXT_PUBLIC_BRAND_NAME="ShipLane"
NEXT_PUBLIC_BRAND_PRODUCT="ShipLane Freight"
NEXT_PUBLIC_BRAND_WEBSITE="www.shiplane.example"
NEXT_PUBLIC_BRAND_EMAIL="support@shiplane.example"
NEXT_PUBLIC_BRAND_PHONE="1800 200 4455"

BRAND_LEGAL_NAME="ShipLane Logistics Private Limited"
BRAND_ADDRESS="Unit 402, Orion Business Park, Sector 62, Noida, Uttar Pradesh, India (201309)"
BRAND_CIN="U63030UP2021PTC148812"
BRAND_PAN="AAFCS4417K"
BRAND_TRANSPORTER_ID="09AAFCS4417K1ZP"
